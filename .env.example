# Milyonuse — every setting the code reads, and nothing else (apps/api/src/config/env.test.ts checks).
# Copy to .env.local for development. Never commit any other .env file.

# ── runtime
# development | test | production
NODE_ENV=development
# where the API listens (long-lived server only)
PORT=4000
# the API's bind address
HOST=0.0.0.0
# debug | info | warn | error
LOG_LEVEL=info

# ── database (db/roles.sql: three roles, three connection strings)
# the API, under row-level security
DATABASE_URL=postgres://milyonuse_app:milyonuse@127.0.0.1:5432/milyonuse
# BYPASSRLS — only before a tenant is known
DATABASE_URL_PLATFORM=postgres://milyonuse_platform:milyonuse@127.0.0.1:5432/milyonuse
# the schema owner — migrations only
DATABASE_URL_MIGRATOR=postgres://milyonuse:milyonuse@127.0.0.1:5432/milyonuse
# the test suites' application role
DATABASE_URL_APP=postgres://milyonuse_app:milyonuse@127.0.0.1:5432/milyonuse
# scripts/db-setup.sh only: creates roles and the database
DATABASE_URL_SUPERUSER=postgres://postgres:postgres@127.0.0.1:5432/postgres
# true for a managed database (Neon)
DATABASE_SSL=false
# connections per pool per instance
DATABASE_POOL_MAX=10

# ── workers (the queue is a table; see modules/queue)
# queued jobs one process runs at once
JOBS_CONCURRENCY=8
# interval: own timers · cron: the host calls /api/v1/cron/:cadence
WORKER_MODE=interval
# ≥32 chars; required when WORKER_MODE=cron (Vercel sends it as a bearer)
# CRON_SECRET=

# ── origins
# origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# the web app's public origin — account mail links point here
APP_BASE_URL=http://127.0.0.1:3000
# where the web app's /api/v1 rewrite sends requests (apps/web/next.config.ts)
API_ORIGIN=http://127.0.0.1:4000
# set by Vercel; the version /health/ready reports
# VERCEL_GIT_COMMIT_SHA=

# ── accounts
# false closes registration (abuse, closed beta)
SIGNUP_ENABLED=true
# the session cookie's name
SESSION_COOKIE_NAME=mu_session
# set to share the cookie across subdomains
# SESSION_COOKIE_DOMAIN=

# ── mail (absent in development: links are logged and handed back in the API's answer)
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# a hosted mailbox's HTTP API instead of SMTP
# MAIL_API_TOKEN=
# where MAIL_API_TOKEN is served
MAIL_API_BASE_URL=https://api.mail.hostinger.com
# the sender; its address picks the mailbox
MAIL_FROM="Milyonuse <no-reply@milyonuse.com>"

# ── operations
# comma-separated; who gets the error digest
# ALERT_EMAILS=ops@example.com
# days a system_log line is kept
LOG_RETENTION_DAYS=90

# ── web
# the public site's origin — canonical URLs, the sitemap, link previews
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
