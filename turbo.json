{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [".env.example", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_ORIGIN", "NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL_APP", "DATABASE_URL_PLATFORM", "DATABASE_URL_MIGRATOR", "POISONBENCH_LIVE", "POISONBENCH_REPORT", "OPENROUTER_API_KEY"]
    },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
