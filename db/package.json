{
  "name": "@milyonuse/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "migrate": "node --env-file-if-exists=../.env.local --experimental-strip-types src/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@milyonuse/config": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
